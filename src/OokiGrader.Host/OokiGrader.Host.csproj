<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <WebProjectDirectory>$(MSBuildProjectDirectory)/../OokiGrader.Web</WebProjectDirectory>
    <WebDistDirectory>$(WebProjectDirectory)/dist</WebDistDirectory>
    <WebNpmCacheDirectory>$(MSBuildProjectDirectory)/obj/npm-cache</WebNpmCacheDirectory>
    <OpenApiGenerateDocuments>true</OpenApiGenerateDocuments>
    <OpenApiGenerateDocumentsOnBuild>false</OpenApiGenerateDocumentsOnBuild>
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/obj/openapi</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--openapi-version OpenApi3_1</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../OokiGrader.Ai.Abstractions/OokiGrader.Ai.Abstractions.csproj" />
    <ProjectReference Include="../OokiGrader.Ai.Gemini/OokiGrader.Ai.Gemini.csproj" />
    <ProjectReference Include="../OokiGrader.Ai.OpenRouter/OokiGrader.Ai.OpenRouter.csproj" />
    <ProjectReference Include="../OokiGrader.Application/OokiGrader.Application.csproj" />
    <ProjectReference Include="../OokiGrader.Contracts/OokiGrader.Contracts.csproj" />
    <ProjectReference Include="../OokiGrader.Domain/OokiGrader.Domain.csproj" />
    <ProjectReference Include="../OokiGrader.Infrastructure/OokiGrader.Infrastructure.csproj" />
    <ProjectReference Include="../OokiGrader.Preprocessing/OokiGrader.Preprocessing.csproj" />
    <ProjectReference Include="../OokiGrader.Reports.Pdf/OokiGrader.Reports.Pdf.csproj" />
  </ItemGroup>

  <Target Name="BuildWebForPublish" AfterTargets="ComputeFilesToPublish">
    <Error
      Condition="!Exists('$(WebProjectDirectory)/package-lock.json')"
      Text="The OokiGrader.Web package-lock.json file is required for a reproducible production publish." />
    <Exec
      WorkingDirectory="$(WebProjectDirectory)"
      Command="npm ci --no-audit --no-fund --cache &quot;$(WebNpmCacheDirectory)&quot;" />
    <Exec
      WorkingDirectory="$(WebProjectDirectory)"
      Command="npm run build" />

    <ItemGroup>
      <_WebDistFiles Include="$(WebDistDirectory)/**/*" />
      <ResolvedFileToPublish Include="@(_WebDistFiles->'%(FullPath)')">
        <RelativePath>wwwroot/%(_WebDistFiles.RecursiveDir)%(_WebDistFiles.Filename)%(_WebDistFiles.Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
